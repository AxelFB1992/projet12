# Copier ce fichier en .env puis renseigner les valeurs : cp .env.example .env
# Pas d'apostrophe (') dans les mots de passe.

# --- PostgreSQL ---
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=

# Rôles applicatifs (un rôle par usage, privilèges minimaux)
APP_WRITER_PASSWORD=
DEBEZIUM_PASSWORD=
ETL_PASSWORD=
POWERBI_PASSWORD=
KESTRA_DB_PASSWORD=

# --- APIs externes ---
GOOGLE_MAPS_API_KEY=
SLACK_WEBHOOK_URL=
